        <mxCell id="Gso4z4nvXB3stpEafE8O-250" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;You may need to install pyusb and / or pyserial in your python.&lt;br&gt;If you use Thonny, go in Tools -&amp;gt; Manage Plug-ins...&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;LegoGwy_FT232.py:&amp;nbsp;&lt;a href=&quot;https://github.com/BlissCA/lego-blockly/blob/main/Misc/LegoGwy_FT232.py&quot;&gt;https://github.com/BlissCA/lego-blockly/blob/main/Misc/LegoGwy_FT232.py&lt;/a&gt;&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;Zadig:&amp;nbsp;&lt;a href=&quot;https://zadig.akeo.ie/&quot;&gt;https://zadig.akeo.ie/&lt;/a&gt;&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;@alexGS TCLOGO_S.COM:&amp;nbsp;&lt;a href=&quot;https://bricksafe.com/files/alexGSofNZ/interface-a-tc-logo/TCLOGO_S.COM&quot;&gt;https://bricksafe.com/files/alexGSofNZ/interface-a-tc-logo/TCLOGO_S.COM&lt;/a&gt;&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;com0com-2.2.2.0-x64-fre-signed.zip:&lt;br&gt;&amp;nbsp;&lt;a href=&quot;https://sourceforge.net/projects/com0com/files/com0com/2.2.2.0/&quot;&gt;https://sourceforge.net/projects/com0com/files/com0com/2.2.2.0/&lt;/a&gt;&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;DOSBox-X:&amp;nbsp;&lt;a href=&quot;https://dosbox-x.com/&quot;&gt;https://dosbox-x.com/&lt;/a&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="490" x="30" y="270" as="geometry" />
        </mxCell>
        <mxCell id="Gso4z4nvXB3stpEafE8O-251" parent="1" style="text;strokeColor=none;fillColor=none;html=1;fontSize=21;fontStyle=1;verticalAlign=middle;align=center;autosizeText=1;" value="Software Gateway to use Legacy DOS software to program Lego Interface A (9750) using a cheap FT232RL module" vertex="1">
