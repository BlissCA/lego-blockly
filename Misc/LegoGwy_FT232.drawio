        <mxCell id="Gso4z4nvXB3stpEafE8O-249" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;PLACE JUMPER TO 5V&lt;/b&gt;" vertex="1">
